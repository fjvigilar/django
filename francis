# templates/store/index.html
{% extends 'store/base.html' %}
{% block content %}
<div class="grid grid-cols-2 md:grid-cols-4 gap-4 animate-fade-in">
  {% for product in products %}
    <div class="border p-4 rounded-xl hover:shadow-xl transition-all">
      <img src="{{ product.image.url }}" class="rounded-xl">
      <h2 class="mt-2 font-semibold">{{ product.name }}</h2>
      <p>${{ product.price }}</p>
      <form method="post" action="/add-to-cart/{{ product.id }}/">{% csrf_token %}<button class="bg-black text-white px-4 py-1 rounded">Add to Cart</button></form>
    </div>
  {% endfor %}
</div>
{% endblock %}

# templates/store/history.html
{% extends 'store/base.html' %}
{% block content %}
<h2 class="text-xl font-bold mb-4">Order History</h2>
{% for order in orders %}
  <div class="mb-4 p-4 border rounded">
    <p><strong>Date:</strong> {{ order.date }}</p>
    <p><strong>Bank Account:</strong> {{ order.bank_account_number }}</p>
    <ul>
      {% for item in order.items.all %}
        <li>{{ item.product.name }} (x{{ item.quantity }})</li>
      {% endfor %}
    </ul>
  </div>
{% endfor %}
{% endblock %}

